# Public site URL used for metadata, canonical URLs, sitemap, robots, and schema.
NEXT_PUBLIC_SITE_URL=https://nexoraorbit.com

# Required for the contact form (src/app/api/contact/route.ts) to send enquiry
# emails. Get a free API key at https://resend.com after creating an account.
RESEND_API_KEY=

# Optional: the "from" address enquiry emails are sent from. Until a sending
# domain is verified in Resend, leave unset — the route falls back to
# Resend's shared onboarding@resend.dev sender, which works out of the box.
# Once nexoraorbit.com is verified in Resend, set this to something like
# "NEXORA ORBIT Enquiries <enquiries@nexoraorbit.com>".
# CONTACT_FROM_EMAIL=

# Optional future variables
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_GTM_ID=
